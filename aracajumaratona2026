<script>
  // Senha simples client-side — não é segurança forte, apenas evita acesso casual.
  // Trocar a senha: edite a constante SITE_PWD abaixo.
  const SITE_PWD = "aracaju2026";

  function checkPwd(){
    const val = document.getElementById('pwd').value;
    if(val === SITE_PWD){
      document.getElementById('gate').style.display = 'none';
      document.getElementById('content').style.display = 'block';
      try{ sessionStorage.setItem('gate_ok','1'); }catch(e){}
    } else {
      document.getElementById('err').style.display = 'block';
    }
  }
  document.getElementById('pwd').addEventListener('keydown', function(e){
    if(e.key === 'Enter') checkPwd();
  });
  try{
    if(sessionStorage.getItem('gate_ok') === '1'){
      document.getElementById('gate').style.display = 'none';
      document.getElementById('content').style.display = 'block';
    }
  }catch(e){}
</script>

</body>
</html>
