<title>Checkpoint — Governança Médica | Maratona de Aracaju 2026</title>
<style>
  :root{
    --azul-900:#0d1b3d;
    --azul-800:#13265a;
    --azul-700:#1b3a7a;
    --azul-600:#2554a8;
    --dourado:#c9a227;
    --verde:#1f8a4c;
    --verde-bg:#e8f6ee;
    --amarelo:#b8860b;
    --amarelo-bg:#fff8e6;
    --vermelho:#c0392b;
    --vermelho-bg:#fdecea;
    --roxo:#6b3fa0;
    --roxo-bg:#f2ecfa;
    --cinza-100:#f4f5f7;
    --cinza-200:#e6e8ec;
    --cinza-500:#6b7280;
    --texto:#1a1f2b;
    --branco:#ffffff;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Segoe UI', Arial, sans-serif;
    background:var(--cinza-100);
    color:var(--texto);
    line-height:1.55;
  }

  /* ===== GATE DE SENHA ===== */
  #gate{
    position:fixed;inset:0;
    background:linear-gradient(135deg,var(--azul-900),var(--azul-700));
    display:flex;align-items:center;justify-content:center;
    z-index:999;
    padding:20px;
  }
  #gate .box{
    background:#fff;
    border-radius:12px;
    padding:36px 32px;
    max-width:380px;
    width:100%;
    text-align:center;
    box-shadow:0 10px 40px rgba(0,0,0,.3);
  }
  #gate h2{margin:0 0 6px 0;color:var(--azul-900);font-size:1.2rem;}
  #gate p{font-size:.85rem;color:var(--cinza-500);margin:0 0 20px 0;}
  #gate input{
    width:100%;
    padding:12px 14px;
    border:1px solid var(--cinza-200);
    border-radius:8px;
    font-size:.95rem;
    margin-bottom:12px;
  }
  #gate button{
    width:100%;
    padding:12px;
    background:var(--azul-700);
    color:#fff;
    border:none;
    border-radius:8px;
    font-size:.95rem;
    font-weight:600;
    cursor:pointer;
  }
  #gate button:hover{background:var(--azul-800);}
  #gate .err{color:var(--vermelho);font-size:.8rem;margin-top:10px;display:none;}
  #content{display:none;}

  .topbar{
    background:linear-gradient(135deg,var(--azul-900),var(--azul-700));
    color:#fff;
    padding:28px 24px;
  }
  .topbar-inner{
    max-width:1000px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    flex-wrap:wrap;
    gap:16px;
  }
  .topbar h1{
    margin:0 0 6px 0;
    font-size:1.5rem;
    letter-spacing:.3px;
  }
  .topbar .sub{
    font-size:.9rem;
    opacity:.85;
  }
  .badge-private{
    background:rgba(255,255,255,.12);
    border:1px solid rgba(255,255,255,.35);
    padding:6px 12px;
    border-radius:20px;
    font-size:.75rem;
    white-space:nowrap;
  }
  .note-banner{
    max-width:1000px;
    margin:18px auto 0 auto;
    padding:14px 18px;
    background:var(--amarelo-bg);
    border:1px solid #f0d78a;
    border-left:4px solid var(--amarelo);
    border-radius:6px;
    font-size:.92rem;
    color:#5c4813;
  }
  .container{
    max-width:1000px;
    margin:0 auto;
    padding:24px;
  }
  .legend-row{
    display:flex;gap:14px;flex-wrap:wrap;
    margin-bottom:20px;
    font-size:.78rem;
    color:var(--cinza-500);
  }
  .legend-row span{display:flex;align-items:center;gap:6px;}
  .legend-dot{width:10px;height:10px;border-radius:50%;display:inline-block;}

  .progress-card{
    background:#fff;
    border:1px solid var(--cinza-200);
    border-radius:10px;
    padding:18px 22px;
    margin-bottom:28px;
    display:flex;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
  }
  .progress-ring{
    font-size:2rem;
    font-weight:700;
    color:var(--azul-700);
    min-width:70px;
  }
  .progress-bar-outer{
    flex:1;
    min-width:200px;
    height:10px;
    background:var(--cinza-200);
    border-radius:6px;
    overflow:hidden;
  }
  .progress-bar-inner{
    height:100%;
    background:linear-gradient(90deg,var(--verde),#27ae60);
    width:23%;
  }
  .progress-label{
    font-size:.85rem;
    color:var(--cinza-500);
  }
  h2.section-title{
    font-size:1.15rem;
    color:var(--azul-900);
    border-bottom:2px solid var(--azul-700);
    padding-bottom:8px;
    margin:36px 0 16px 0;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .owner-tag{
    font-size:.65rem;
    font-weight:700;
    padding:3px 10px;
    border-radius:12px;
    text-transform:uppercase;
    letter-spacing:.3px;
  }
  .owner-tag.rafael{background:var(--roxo-bg);color:var(--roxo);}
  .owner-tag.neto{background:#e8f0fe;color:var(--azul-700);}

  .item{
    background:#fff;
    border:1px solid var(--cinza-200);
    border-radius:8px;
    margin-bottom:12px;
    overflow:hidden;
  }
  .item.rafael{border-left:4px solid var(--roxo);}
  .item.neto{border-left:4px solid var(--azul-600);}
  .item-head{
    display:flex;
    align-items:center;
    gap:12px;
    padding:14px 16px;
    flex-wrap:wrap;
  }
  .status-dot{
    width:12px;height:12px;border-radius:50%;
    flex-shrink:0;
  }
  .status-dot.ok{background:var(--verde);}
  .status-dot.pending{background:var(--amarelo);}
  .status-dot.blocked{background:var(--vermelho);}
  .item-q{
    font-weight:600;
    font-size:.98rem;
    flex:1;
    min-width:200px;
  }
  .status-tag{
    font-size:.72rem;
    padding:3px 10px;
    border-radius:12px;
    font-weight:600;
    white-space:nowrap;
  }
  .status-tag.ok{background:var(--verde-bg);color:var(--verde);}
  .status-tag.pending{background:var(--amarelo-bg);color:var(--amarelo);}
  .item-body{
    padding:0 16px 16px 40px;
    font-size:.92rem;
    color:#333;
  }
  .item-body .answer{
    background:var(--verde-bg);
    border-left:3px solid var(--verde);
    padding:10px 14px;
    border-radius:4px;
    margin-top:4px;
  }
  .item-body ul{margin:6px 0;padding-left:20px;}
  .known-box{
    background:#eef2fb;
    border-left:3px solid var(--azul-600);
    padding:10px 14px;
    border-radius:4px;
    font-size:.88rem;
    margin-top:8px;
    color:#1b2e5c;
  }
  .flag-box{
    background:var(--vermelho-bg);
    border-left:3px solid var(--vermelho);
    padding:10px 14px;
    border-radius:4px;
    font-size:.88rem;
    margin-top:8px;
    color:#7a241c;
  }
  table.data-table{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
    font-size:.85rem;
  }
  table.data-table th, table.data-table td{
    border:1px solid var(--cinza-200);
    padding:6px 10px;
    text-align:left;
  }
  table.data-table th{
    background:var(--cinza-100);
  }
  .footer-note{
    margin-top:40px;
    padding:20px;
    background:#fff;
    border:1px solid var(--cinza-200);
    border-radius:8px;
    font-size:.85rem;
    color:var(--cinza-500);
    text-align:center;
  }
  .footer-note strong{color:var(--azul-800);}
  .layout-lock{
    margin-top:14px;
    padding:12px 16px;
    background:var(--roxo-bg);
    border-radius:6px;
    font-size:.8rem;
    color:#4a2a70;
  }

  @media print{
    #gate{display:none !important;}
    #content{display:block !important;}
    body{background:#fff;}
    .note-banner, .topbar .badge-private{display:none;}
    .item{break-inside:avoid;}
    .topbar{background:var(--azul-900) !important; -webkit-print-color-adjust:exact; print-color-adjust:exact;}
  }
</style>
